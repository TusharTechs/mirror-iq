# Prototype 0.2 default: true
DEMO_MODE=true

# YouCam API credentials. Never commit real keys.
YOUCAM_API_KEY=

# Verified Base URL
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com

# Verified Auth Style
YOUCAM_AUTH_STYLE=bearer

# Verified VTO Paths
YOUCAM_VTO_SUBMIT_PATH=/s2s/v2.0/task/cloth-v4
YOUCAM_VTO_STATUS_PATH_TEMPLATE=/s2s/v2.0/task/cloth-v4

# Request timeout in milliseconds.
YOUCAM_TIMEOUT_MS=45000

# Log response STRUCTURE (keys/types/lengths, never values) during live tests.
YOUCAM_LOG_SHAPE=false